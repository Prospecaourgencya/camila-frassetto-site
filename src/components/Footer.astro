---
import { business } from '../data/business';
const a = business.address;
const wa = `https://wa.me/${business.whatsapp}?text=Ol%C3%A1%20Camila!%20Vim%20pelo%20seu%20site%20e%20gostaria%20de%20agendar%20uma%20conversa.`;
const year = new Date().getFullYear();
---
<footer class="rc-foot">
  <div class="rc-foot__in">
    <div class="rc-foot__brand">
      <a href="#topo" style="text-decoration:none"><b>Camila Frassetto</b></a>
      <p>{business.jobTitle} em {a.city} · Atendimento humano, ético e sigiloso, presencial e online.</p>
      <p class="rc-foot__nap">
        {a.street} — {a.neighborhood}, {a.city}/{a.state}, CEP {a.postalCode}<br />
        <a href={`tel:${business.phoneE164}`}>{business.phoneDisplay}</a>
        {business.crp && <> · <span>{business.crp}</span></>}
      </p>
    </div>
    <div class="rc-fcol">
      <h3>Navegação</h3>
      <a href="#sobre">Sobre</a><a href="#servicos">Serviços</a><a href="#depoimentos">Depoimentos</a><a href="#faq">Dúvidas</a><a href="#contato">Contato</a>
    </div>
    <div class="rc-fcol">
      <h3>Onde me encontrar</h3>
      <a href={wa} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15l-1.4 5 5.2-1.4A10 10 0 1 0 12 2z"/></svg> WhatsApp</a>
      <a href={business.instagram} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg> Instagram</a>
      <a href={business.mapsUrl} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s-7-5.7-7-11a7 7 0 0 1 14 0c0 5.3-7 11-7 11z"/><circle cx="12" cy="10" r="2.4"/></svg> {a.city} (Maps)</a>
    </div>
  </div>
  <div class="rc-foot__bot"><span>&copy; {year} Camila Frassetto · Todos os direitos reservados.</span><a href="#topo" style="color:#9ec4ad;text-decoration:none">Voltar ao topo &uarr;</a></div>
</footer>
