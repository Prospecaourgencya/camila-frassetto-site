---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import { business, reviews, faqs } from '../data/business';

const wa = (msg: string) => `https://wa.me/${business.whatsapp}?text=${msg}`;
const waConversa = wa('Ol%C3%A1%20Camila!%20Vim%20pelo%20seu%20site%20e%20gostaria%20de%20agendar%20uma%20conversa.');
const a = business.address;

const servicos = [
  { n: '01', h: 'Terapia de casal', p: 'Reconstruir a comunicação, a confiança e a conexão — em um espaço neutro e seguro para os dois.' },
  { n: '02', h: 'Relacionamentos e vínculos', p: 'Entender os seus padrões nas relações e construir vínculos mais saudáveis e leves.' },
  { n: '03', h: 'Ciúme, insegurança e términos', p: 'Atravessar crises, ciúmes e separações sem se perder no caminho.' },
  { n: '04', h: 'Autoestima e autoconhecimento', p: 'Voltar a se reconhecer e se respeitar — a base para amar bem sem se anular.' },
];
const sessao = [
  { n: '01', h: 'Acolhimento sem julgamento', p: 'Você pode falar do que quiser, do seu jeito. Este é um espaço seguro para ser quem você é.' },
  { n: '02', h: 'Respeito ao seu tempo', p: 'Nada é forçado. Caminhamos no ritmo que faz sentido para você, com cuidado em cada passo.' },
  { n: '03', h: 'Ética e sigilo', p: 'O que é conversado aqui fica aqui. Compromisso integral com a confidencialidade e a ética profissional.' },
];
const sintomas = [
  'As mesmas brigas se repetem — vocês discutem por tudo e nada realmente se resolve.',
  'A conversa virou silêncio — parece que vocês já não se entendem como antes.',
  'Ciúme, insegurança ou desconfiança tirando a paz da relação.',
  'O afeto e a intimidade esfriaram — a rotina foi ocupando o lugar do carinho.',
  'Você se anula pela relação — e sente que está se perdendo no caminho.',
  'A dúvida se vale a pena continuar — e o medo de tomar a decisão errada.',
];
---
<Base>
  <Header />
  <Hero />

  <!-- Ticker -->
  <div class="cx-ticker" aria-hidden="true"><div class="cx-ticker__t" id="cxticker"></div></div>

  <!-- ===== RECONHECIMENTO ===== -->
  <section class="rc-sec" id="reconhecimento">
    <div class="rc-wrap">
      <span class="rc-kick cx-rise">Você não está sozinho</span>
      <h2 class="rc-h2 cx-rise" data-d="1">Talvez você se <em>reconheça aqui</em>.</h2>
      <p class="rc-lead cx-rise" data-d="1">Às vezes a relação esfria, a comunicação trava e o que era leve começa a pesar — você sente que algo não vai bem, mesmo sem saber nomear. Você não precisa esperar chegar ao limite para buscar ajuda.</p>
      <span class="rc-sub cx-rise" data-d="2">Talvez você ande sentindo</span>
      <div class="rc-syms">
        {sintomas.map((t, i) => (
          <div class="rc-sym cx-rise" data-d={(i % 2) + 1}><span class="rc-sym__n">{String(i + 1).padStart(2, '0')}</span><p>{t}</p></div>
        ))}
      </div>
      <p class="rc-close cx-rise">Se você se reconheceu em algum desses pontos, talvez seja hora de olhar pra isso com cuidado — no seu tempo, com apoio de verdade.</p>
    </div>
  </section>

  <!-- ===== SOBRE ===== -->
  <section class="rc-sec rc-sec--warm" id="sobre">
    <div class="rc-wrap rc-about">
      <div>
        <span class="rc-kick cx-rise">Psicóloga clínica · Atendimento particular</span>
        <h2 class="rc-h2 cx-rise" data-d="1">Prazer, sou a <em>Camila</em></h2>
        <p class="rc-lead cx-rise" data-d="1">Sou <strong>Camila Frassetto</strong>, psicóloga clínica em Piracicaba com mais de <strong>7 anos</strong> de prática. Atendo de forma <strong>particular e com agenda limitada</strong> — porque cuidar dos relacionamentos, da autoestima e dos momentos difíceis da vida exige tempo, presença e sigilo de verdade.</p>
        <p class="rc-hl cx-rise" data-d="1">Escutar de verdade é raro — e é disso que se trata o meu trabalho.</p>
        <p class="rc-lead cx-rise" data-d="2">Trabalho com atendimento limitado para garantir atenção total a cada pessoa. Meu papel é caminhar ao seu lado, com escuta ativa, ética e respeito.</p>
        <div class="rc-btnrow cx-rise" data-d="2"><a class="rc-btn" href={waConversa} target="_blank" rel="noopener">Agendar uma conversa <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
      </div>
      <div class="rc-about__ph cx-rise" data-d="1">
        <picture>
          <source type="image/avif" srcset="/img/sobre.avif" />
          <source type="image/webp" srcset="/img/sobre.webp" />
          <img src="/img/sobre.webp" width="680" height="1020" alt="Camila Frassetto, psicóloga clínica, sorrindo no consultório em Piracicaba" loading="lazy" decoding="async" />
        </picture>
      </div>
    </div>
  </section>

  <!-- ===== ABORDAGEM ===== -->
  <section class="rc-sec" id="abordagem">
    <div class="rc-wrap">
      <span class="rc-kick cx-rise">A abordagem</span>
      <h2 class="rc-h2 cx-rise" data-d="1">O meu cuidado, <em>sem complicar</em></h2>
      <p class="rc-lead cx-rise" data-d="1">No centro de tudo existe uma coisa simples e poderosa:</p>
      <p class="rc-big cx-rise" data-d="2">a escuta</p>
      <p class="rc-lead cx-rise" data-d="2">Aqui não existe fórmula pronta. Cada processo é construído com você, respeitando o seu tempo, a sua história e aquilo que faz sentido para a sua vida. Um espaço de escuta, sigilo e respeito — onde você pode falar sem medo de julgamento e caminhar com apoio de verdade.</p>
    </div>
  </section>

  <!-- ===== COMO EU TRABALHO ===== -->
  <section class="rc-sec rc-sec--warm rc-quote" id="comotrabalho">
    <div class="rc-wrap">
      <span class="rc-kick cx-rise">Como eu trabalho</span>
      <p class="rc-bigq cx-rise" data-d="1"><span class="qm">&ldquo;</span>Cada sessão é adaptada às suas necessidades individuais.<span class="qm">&rdquo;</span></p>
      <p class="rc-by cx-rise" data-d="2">— Camila Frassetto</p>
    </div>
  </section>

  <!-- ===== MANIFESTO ===== -->
  <section class="rc-pq" id="manifesto">
    <div class="rc-pq__bg">
      <picture>
        <source type="image/avif" srcset="/img/manifesto.avif" />
        <source type="image/webp" srcset="/img/manifesto.webp" />
        <img src="/img/manifesto.webp" width="680" height="1020" alt="Camila Frassetto" loading="lazy" decoding="async" data-parallax="0.12" />
      </picture>
    </div>
    <div class="rc-wrap">
      <span class="rc-kick cx-rise">Manifesto</span>
      <p class="rc-pq__q cx-rise" data-d="1">Até que você torne o inconsciente consciente, ele dirigirá sua vida e você o chamará de destino.</p>
      <p class="rc-pq__by cx-rise" data-d="2">— Carl Jung</p>
    </div>
  </section>

  <!-- ===== COMO É O ENCONTRO ===== -->
  <section class="rc-sec" id="sessao">
    <div class="rc-wrap">
      <span class="rc-kick cx-rise">Como é o nosso encontro</span>
      <h2 class="rc-h2 cx-rise" data-d="1">No consultório — <em>ou online</em></h2>
      <p class="rc-lead cx-rise" data-d="1">Um espaço seguro, discreto e sem pressa — onde cada palavra da sua história é tratada com cuidado. O trabalho acontece em <strong>acompanhamento contínuo</strong>, com encontros semanais, e com <strong>emissão de nota fiscal</strong> para reembolso no seu plano de saúde.</p>
      <div class="rc-rows">
        {sessao.map((r) => (
          <div class="rc-row cx-rise" data-d="1"><span class="rc-row__n">{r.n}</span><div><h3>{r.h}</h3><p>{r.p}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== SERVIÇOS ===== -->
  <section class="rc-sec rc-sec--warm" id="servicos">
    <div class="rc-wrap">
      <span class="rc-kick cx-rise">Como posso ajudar</span>
      <h2 class="rc-h2 cx-rise" data-d="1">Não é sobre fórmula pronta. <em>É sobre você.</em></h2>
      <div class="rc-rows">
        {servicos.map((r) => (
          <div class="rc-row cx-rise" data-d="1"><span class="rc-row__n">{r.n}</span><div><h3>{r.h}</h3><p>{r.p}</p></div></div>
        ))}
      </div>
      <div class="rc-btnrow cx-rise"><a class="rc-btn" href={waConversa} target="_blank" rel="noopener">Quero agendar uma conversa <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
    </div>
  </section>

  <!-- ===== DEPOIMENTOS ===== -->
  <section class="rc-sec" id="depoimentos">
    <div class="rc-wrap">
      <span class="rc-kick cx-rise">Quem já passou por aqui</span>
      <h2 class="rc-h2 cx-rise" data-d="1">O que dizem <em>meus pacientes</em></h2>
      <p class="rc-lead cx-rise" data-d="1">Relatos reais de quem fez terapia comigo.</p>
      <a class="rc-gstars cx-rise" data-d="1" href={business.mapsUrl} target="_blank" rel="noopener" aria-label="Avaliação 5,0 de 5 com 28 avaliações no Google">
        <strong>5,0</strong><span class="rc-gstars__st" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span>28 avaliações no Google</span>
      </a>
      <div class="rc-revs">
        {reviews.map((r) => (
          <div class="rc-rev cx-rise">
            <div class="rc-rev__st" aria-label={`${r.rating} de 5 estrelas`}>&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <p>{r.body}</p>
            <div class="rc-rev__who"><span class="rc-rev__av">{r.author.charAt(0)}</span><span class="rc-rev__nm">{r.author}<small>{r.source}</small></span></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="rc-sec rc-sec--warm" id="faq">
    <div class="rc-wrap">
      <span class="rc-kick cx-rise">Dúvidas frequentes</span>
      <h2 class="rc-h2 cx-rise" data-d="1">Perguntas que quase todo mundo <em>faz</em></h2>
      <div class="rc-faq">
        {faqs.map((f) => (
          <details class="rc-faq__item cx-rise">
            <summary>{f.q}<span class="rc-faq__ic" aria-hidden="true"></span></summary>
            <div class="rc-faq__a">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CONTATO ===== -->
  <section class="rc-sec rc-cta" id="contato">
    <div class="rc-wrap">
      <span class="rc-kick cx-rise">Vamos conversar</span>
      <h2 class="cx-rise" data-d="1">Dê o <em>primeiro passo</em></h2>
      <p class="rc-cta__sub cx-rise" data-d="1">As vagas para novos pacientes são limitadas, para garantir dedicação real a cada processo. Me chame no canal que preferir — o primeiro passo é uma conversa.</p>
      <div class="rc-cta__row cx-rise" data-d="2">
        <a class="rc-cc rc-cc--wa" href={waConversa} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15l-1.4 5 5.2-1.4A10 10 0 1 0 12 2z"/></svg> WhatsApp · Agendar agora</a>
        <a class="rc-cc" href={business.instagram} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg> {business.instagramHandle}</a>
        <a class="rc-cc" href={business.mapsUrl} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s-7-5.7-7-11a7 7 0 0 1 14 0c0 5.3-7 11-7 11z"/><circle cx="12" cy="10" r="2.4"/></svg> {a.neighborhood}, {a.city} · Presencial &amp; Online</a>
      </div>
      <div class="rc-map cx-rise" data-d="2">
        <iframe title={`Mapa do consultório de Camila Frassetto em ${a.city}`} src={business.mapsEmbed} width="100%" height="320" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <p class="rc-cta__addr">{a.street} — {a.neighborhood}, {a.city}/{a.state} · CEP {a.postalCode}</p>
    </div>
  </section>

  <Footer />
</Base>

<script>
  // reveal on scroll
  const io = new IntersectionObserver((es) => {
    es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: 0.16, rootMargin: '0px 0px -8% 0px' });
  document.querySelectorAll('.cx-rise').forEach((el) => io.observe(el));

  // ticker
  const mq = document.getElementById('cxticker');
  if (mq) {
    const items = ['Atendimento particular', 'Terapia de casal', 'Terapia individual', '<b>Presencial em Piracicaba &amp; Online</b>', 'Agenda limitada', 'Sigilo profissional', 'Acompanhamento contínuo', 'Nota fiscal para reembolso'];
    const unit = items.map((t) => '<span>' + t + ' <i>&#10022;</i></span>').join('');
    mq.innerHTML = unit + unit;
  }

  // parallax
  const px = document.querySelectorAll<HTMLElement>('[data-parallax]');
  const onScroll = () => {
    const vh = window.innerHeight;
    px.forEach((el) => {
      const parent = el.parentElement?.parentElement; // picture > div
      if (!parent) return;
      const r = parent.getBoundingClientRect();
      const p = (r.top + r.height / 2 - vh / 2) / vh;
      el.style.transform = 'translateY(' + p * parseFloat(el.dataset.parallax || '0') * 100 + 'px)';
    });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // navbar scrolled state
  const bar = document.querySelector('.topbar');
  if (bar) {
    const f = () => bar.classList.toggle('scrolled', window.scrollY > 40);
    window.addEventListener('scroll', f, { passive: true });
    f();
  }
</script>
